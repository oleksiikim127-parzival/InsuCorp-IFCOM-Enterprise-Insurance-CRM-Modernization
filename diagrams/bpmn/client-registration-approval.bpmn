        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Matching_di" bpmnElement="Annotation_Matching">
        <dc:Bounds x="100.0" y="312.0" width="330.0" height="70.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_ReviewPolicy_di" bpmnElement="Annotation_ReviewPolicy">
        <dc:Bounds x="1100.0" y="882.0" width="330.0" height="55.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_RegistrationStates_di" bpmnElement="Annotation_RegistrationStates">
        <dc:Bounds x="1490.0" y="302.0" width="335.0" height="42.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Rejection_di" bpmnElement="Annotation_Rejection">
        <dc:Bounds x="1570.0" y="882.0" width="440.0" height="55.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Enter_di" bpmnElement="Flow_Start_Enter">
        <di:waypoint x="154.0" y="186.0" />
        <di:waypoint x="215.0" y="186.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Enter_Submit_di" bpmnElement="Flow_Enter_Submit">
        <di:waypoint x="360.0" y="186.0" />
        <di:waypoint x="415.0" y="186.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_Check_di" bpmnElement="Flow_Submit_Check">
        <di:waypoint x="477.5" y="225.0" />
        <di:waypoint x="477.5" y="390" />
        <di:waypoint x="597.5" y="390" />
        <di:waypoint x="597.5" y="412.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_Duplicate_di" bpmnElement="Flow_Check_Duplicate">
        <di:waypoint x="685.0" y="454.5" />
        <di:waypoint x="745.0" y="455.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Duplicate_Yes_di" bpmnElement="Flow_Duplicate_Yes">
        <di:waypoint x="770.0" y="430.0" />
        <di:waypoint x="770.0" y="364.5" />
        <di:waypoint x="875.0" y="364.5" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="745" y="342" width="140" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShowDuplicate_End_di" bpmnElement="Flow_ShowDuplicate_End">
        <di:waypoint x="1020.0" y="364.5" />
        <di:waypoint x="1080.0" y="365.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Duplicate_No_di" bpmnElement="Flow_Duplicate_No">
        <di:waypoint x="770.0" y="480.0" />
