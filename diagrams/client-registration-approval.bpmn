<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_IFCOM_Client_Registration" targetNamespace="https://github.com/oleksiikim127-parzival/InsuCorp-IFCOM-Enterprise-Insurance-CRM-Modernization" exporter="Camunda Web Modeler" exporterVersion="544d379" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_IFCOM">
    <bpmn:participant id="Participant_1sn1ebp" name="IFCOM+ - Client Registration and Approval" processRef="Process_0c2k5kv" />
    <bpmn:textAnnotation id="Annotation_Matching">
      <bpmn:text>OQ-001: confirm the company matching key.
OQ-002: clarify verification semantics.
IČO is proposed under A-CRM-001.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_ReviewPolicy">
      <bpmn:text>OQ-004: define the approval review view.
OQ-005: define self-approval / segregation of duties.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_RegistrationStates">
      <bpmn:text>OQ-007: confirm final registration state names and permitted transitions.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Rejection">
      <bpmn:text>OQ-006 / OQ-007: define rejection, correction, resubmission and final registration states.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Matching" sourceRef="Annotation_Matching" targetRef="Task_CheckDuplicate" />
    <bpmn:association id="Association_Rejection" sourceRef="Annotation_Rejection" targetRef="Task_EnterRejectionReason" />
    <bpmn:association id="Association_ReviewPolicy" sourceRef="Annotation_ReviewPolicy" targetRef="Task_ReviewRegistration" />
    <bpmn:association id="Association_RegistrationStates" sourceRef="Annotation_RegistrationStates" targetRef="Task_RecordApproval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0c2k5kv" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0rcbqqf">
      <bpmn:lane id="Lane_0qwmust" name="Manager">
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterRejectionReason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Reminder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_127dfxk" name="IFCOM+ System">
        <bpmn:flowNodeRef>Task_CheckDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RouteApprover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotCreated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReminder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04it5tl" name="Agent">
        <bpmn:flowNodeRef>Start_RegistrationNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterRegistrationData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRegistration</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_RegistrationNeeded" name="Registration needed">
      <bpmn:outgoing>Flow_Start_Enter</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterRegistrationData" name="Enter company registration data">
      <bpmn:incoming>Flow_Start_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_Enter_Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitRegistration" name="Submit registration">
      <bpmn:incoming>Flow_Enter_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckDuplicate" name="Check company duplication using agreed matching rule">
      <bpmn:documentation>Derived duplicate prevention under FR-CRM-006 and BR-CRM-002 to BR-CRM-005. The company key remains OQ-001. This Agent-initiated view abstracts form validation, validation-error feedback and technical failure handling; it does not resolve the separate verification capability in OQ-002.</bpmn:documentation>
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_0y18ize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShowDuplicate" name="Show neutral duplicate result">
      <bpmn:documentation>The response must not expose owner identity or inaccessible client data.</bpmn:documentation>
      <bpmn:incoming>Flow_Duplicate_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_1vfdgb5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreateRegistration" name="Create registration and assign creator as owner">
      <bpmn:documentation>Traceability: FR-CRM-007, FR-RBAC-008, BR-CRM-006, BR-CRM-007.</bpmn:documentation>
      <bpmn:incoming>Flow_Duplicate_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RouteApprover" name="Assign authorized approver BLOCKED OQ-003">
      <bpmn:documentation>The selection rule is blocked until OQ-003 is answered.</bpmn:documentation>
      <bpmn:incoming>Flow_Create_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Duplicate" name="Company already registered?">
      <bpmn:incoming>Flow_0y18ize</bpmn:incoming>
      <bpmn:outgoing>Flow_Duplicate_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Duplicate_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NotCreated" name="Registration not created">
      <bpmn:incoming>Flow_1vfdgb5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?">
      <bpmn:incoming>Flow_0sj22gc</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Reminder" name="Reminder sent; review continues">
      <bpmn:incoming>Flow_Reminder_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyApproval" name="Notify owner of approval PROPOSED A-APR-003">
      <bpmn:incoming>Flow_0dr6te5</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyApproval_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Approved" name="Approval completed">
      <bpmn:incoming>Flow_NotifyApproval_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyRejection" name="Notify owner of rejection PROPOSED A-APR-003">
      <bpmn:incoming>Flow_Rejection_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyRejection_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Proposed rejection outcome">
      <bpmn:incoming>Flow_NotifyRejection_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_EnterRejectionReason" name="Enter rejection reason PROPOSED A-APR-002">
      <bpmn:incoming>Flow_Decision_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reason_RecordRejection</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RecordRejection" name="Record rejection PROPOSED A-APR-001">
      <bpmn:documentation>Rejection, resubmission, edit rights, and the resulting state remain unresolved under OQ-006 and OQ-007.</bpmn:documentation>
      <bpmn:incoming>Flow_Reason_RecordRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejection_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RecordApproval" name="Record approval and complete registration">
      <bpmn:documentation>The final registration state name remains unresolved under OQ-007.</bpmn:documentation>
      <bpmn:incoming>Flow_Decision_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_0dr6te5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewRegistration" name="Review registration request BLOCKED OQ-004 / OQ-005">
      <bpmn:documentation>Source-backed approval step. OQ-004 must define the permitted review view; OQ-005 must define self-approval.</bpmn:documentation>
      <bpmn:incoming>Flow_Route_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_0sj22gc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendReminder" name="Send review reminder PROPOSED A-APR-004">
      <bpmn:incoming>Flow_0o9qo35</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_Reminder" name="48 hours · PROPOSED A-APR-004" cancelActivity="false" attachedToRef="Task_ReviewRegistration">
      <bpmn:documentation>Non-interrupting proposed reminder. It does not complete, cancel, or decide the Manager review task.</bpmn:documentation>
      <bpmn:outgoing>Flow_0o9qo35</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_48Hours">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Start_Enter" sourceRef="Start_RegistrationNeeded" targetRef="Task_EnterRegistrationData" />
    <bpmn:sequenceFlow id="Flow_Enter_Submit" sourceRef="Task_EnterRegistrationData" targetRef="Task_SubmitRegistration" />
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="Task_SubmitRegistration" targetRef="Task_CheckDuplicate" />
    <bpmn:sequenceFlow id="Flow_0y18ize" sourceRef="Task_CheckDuplicate" targetRef="Gateway_Duplicate" />
    <bpmn:sequenceFlow id="Flow_Duplicate_Yes" name="Duplicate confirmed" sourceRef="Gateway_Duplicate" targetRef="Task_ShowDuplicate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">duplicateConfirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1vfdgb5" sourceRef="Task_ShowDuplicate" targetRef="End_NotCreated" />
    <bpmn:sequenceFlow id="Flow_Duplicate_No" name="No duplicate" sourceRef="Gateway_Duplicate" targetRef="Task_CreateRegistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(duplicateConfirmed)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Create_Route" sourceRef="Task_CreateRegistration" targetRef="Task_RouteApprover" />
    <bpmn:sequenceFlow id="Flow_Route_Review" sourceRef="Task_RouteApprover" targetRef="Task_ReviewRegistration" />
    <bpmn:sequenceFlow id="Flow_0sj22gc" sourceRef="Task_ReviewRegistration" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Decision_Approve" name="Approve" sourceRef="Gateway_Decision" targetRef="Task_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_Decision_Reject" name="Reject · A-APR-001" sourceRef="Gateway_Decision" targetRef="Task_EnterRejectionReason" />
    <bpmn:sequenceFlow id="Flow_Reminder_End" sourceRef="Task_SendReminder" targetRef="End_Reminder" />
    <bpmn:sequenceFlow id="Flow_0dr6te5" sourceRef="Task_RecordApproval" targetRef="Task_NotifyApproval" />
    <bpmn:sequenceFlow id="Flow_NotifyApproval_End" sourceRef="Task_NotifyApproval" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_Rejection_Notify" sourceRef="Task_RecordRejection" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_NotifyRejection_End" sourceRef="Task_NotifyRejection" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Reason_RecordRejection" sourceRef="Task_EnterRejectionReason" targetRef="Task_RecordRejection" />
    <bpmn:sequenceFlow id="Flow_0o9qo35" sourceRef="Boundary_Reminder" targetRef="Task_SendReminder" />
  </bpmn:process>
